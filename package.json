{
  "name": "dubber-project",
  "version": "1.0.0",
  "description": "Professional Dubber Project with Express, Tailwind CSS, and Vanilla JS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon",
    "dev:all": "npx concurrently -k -i --hide 1 \"npm run dev\" \"npm run watch:css\"",
    "setup:hooks": "git config core.hooksPath .githooks",
    "build:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --watch",
    "test": "node tests/e2e-api.test.js",
    "test:whisper": "node tests/live-transcribe-api.test.js",
    "test:translate": "node tests/translation-api.test.js",
    "test:pipeline": "node tests/full-pipeline.test.js",
    "test:ui": "node tests/ui-layout-verify.test.js",
    "test:regression": "node tests/regression-body-limit.test.js",
    "test:all": "node tests/e2e-api.test.js && node tests/regression-body-limit.test.js"
  },
  "keywords": [
    "dubber",
    "express",
    "tailwind",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.22.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.6.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
