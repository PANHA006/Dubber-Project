# Application Configuration
PORT=5000
NODE_ENV=development

# Max JSON / urlencoded request body size (bulk subtitle payloads can reach several MB)
BODY_LIMIT=50mb

# Cloud STT: Groq Whisper API Key (Ultra-Fast 1-2s Cloud Transcription)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Commercial Specialist STT: Deepgram API Key (Optional)
# Get a key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Transcription Engine (Faster-Whisper local worker)
TRANSCRIPTION_ENGINE=whisper
WHISPER_MODEL=base

# Python interpreter used by the Faster-Whisper & Edge-TTS workers.
# Leave empty to auto-detect a project-local ".venv" folder (recommended).
# Only set this when your virtualenv lives outside the project folder.
# Windows example: PYTHON_PATH=D:\path\to\your\venv\Scripts\python.exe
PYTHON_PATH=

# Optional: extra folder that contains an ffmpeg binary for the Python workers
# FFMPEG_BIN_DIR=

# Google Gemini API Key (dedicated to text-to-Khmer translation).
# Multiple keys are supported (comma or newline separated) for automatic
# rotation / failover when a key hits its quota.
GEMINI_API_KEY=your_gemini_api_key_here

# Model actually used by the translation service (the runtime reads this one).
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite

# Legacy / descriptive model name kept for documentation and tests.
GEMINI_MODEL=gemini-3.6-flash

# Free-tier daily request quota per API key (used for key-pool status reporting)
GEMINI_DAILY_QUOTA_PER_KEY=20

# Optional: working folder for scripts/translate_khmer_subtitles.js
# (input bilingual subtitle file + translated outputs + cache).
# Override per run with: node scripts/translate_khmer_subtitles.js --dir=<path>
# SUBTITLE_DIR=
# Optional: input file name inside SUBTITLE_DIR (default: subtitle_bilingual.txt)
# SUBTITLE_INPUT=subtitle_bilingual.txt

# ===================================================================
# TRANSLATION ROUTING MODE (Smart Language Routing)
# ===================================================================
# auto   (default) — Chinese source  -> direct zh->km (1 quota, hides the EN line)
#                    any other source -> 2-step bridge (2 quotas, shows the EN line)
# bridge           — always use the 2-step pipeline (legacy behaviour)
# direct           — always use the single-call direct pipeline
TRANSLATION_MODE=auto

# Hugging Face Free API Token for AI Voice & BGM Stem Separation
# Get a free token at: https://huggingface.co/settings/tokens
# HF_TOKEN=
# HF_SEPARATOR_SPACE=abidlabs/music-separation
