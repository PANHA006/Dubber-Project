# Application Configuration
PORT=5000
NODE_ENV=development

# Max JSON / urlencoded request body size (bulk subtitle payloads can reach several MB)
BODY_LIMIT=50mb

# Cloud STT: Groq Whisper API Key (Ultra-Fast 1-2s Cloud Transcription)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Commercial Specialist STT: Deepgram API Key (Optional)
# Get a key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Transcription Engine (Faster-Whisper local worker)
TRANSCRIPTION_ENGINE=whisper
WHISPER_MODEL=base

# Python interpreter used by the Faster-Whisper & Edge-TTS workers.
# Leave empty to auto-detect a project-local ".venv" folder.
# Windows example: PYTHON_PATH=D:\path\to\venv\Scripts\python.exe
PYTHON_PATH=

# Optional: extra folder that contains an ffmpeg binary for the Python workers
# FFMPEG_BIN_DIR=

# Google Gemini API Key (dedicated to text-to-Khmer translation).
# Multiple keys are supported (comma or newline separated) for automatic
# rotation / failover when a key hits its quota.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite
# Free-tier daily request quota per API key (used for key-pool status reporting)
GEMINI_DAILY_QUOTA_PER_KEY=20
